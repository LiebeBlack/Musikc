/* True HQ Audio — studio dark theme (generated by scripts/export_stylesheet.py)
 * Palette tokens are defined in src/ui/theme.py:Palette.
 */


    * {
        outline: none;
    }

    QWidget {
        color: #E9EEF7;
        background-color: transparent;
        selection-background-color: #173B36;
        selection-color: #E9EEF7;
    }

    QMainWindow, #RootSurface {
        background-color: #080A0F;
    }

    #ContentSurface {
        background-color: #080A0F;
    }

    #Card, QFrame#Card {
        background-color: #0E1118;
        border: 1px solid #222B3B;
        border-radius: 14px;
    }

    #CardRaised, QFrame#CardRaised {
        background-color: #131823;
        border: 1px solid #222B3B;
        border-radius: 14px;
    }

    #HeaderSurface {
        background-color: #0E1118;
        border-bottom: 1px solid #222B3B;
    }

    #FooterSurface {
        background-color: #0E1118;
        border-top: 1px solid #222B3B;
    }

    QLabel {
        background: transparent;
    }

    QLabel#AppTitle {
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 3px;
        color: #E9EEF7;
    }

    QLabel#AppSubtitle {
        font-size: 10px;
        letter-spacing: 2px;
        color: #64708A;
    }

    QLabel#SectionTitle {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 2px;
        color: #64708A;
    }

    QLabel#TrackTitle {
        font-size: 30px;
        font-weight: 700;
        color: #E9EEF7;
    }

    QLabel#TrackArtist {
        font-size: 14px;
        color: #9AA5B8;
    }

    QLabel#TrackAlbum {
        font-size: 12px;
        color: #64708A;
    }

    QLabel#TimeLabel {
        font-size: 12px;
        color: #9AA5B8;
    }

    QLabel#MonoValue {
        font-family: "Cascadia Mono";
        font-size: 12px;
        color: #E9EEF7;
    }

    QLabel#Hint {
        color: #64708A;
        font-size: 11px;
    }

    QLabel#Warning {
        color: #F5B44B;
        font-size: 11px;
    }

    QLabel#Error {
        color: #F87171;
        font-size: 11px;
    }

    QToolTip {
        background-color: #182030;
        color: #E9EEF7;
        border: 1px solid #2E3A4E;
        padding: 6px 9px;
        border-radius: 6px;
    }

    QComboBox {
        background-color: #131823;
        border: 1px solid #222B3B;
        border-radius: 9px;
        padding: 6px 12px;
        min-height: 22px;
        color: #E9EEF7;
        selection-background-color: #173B36;
    }

    QComboBox:hover {
        border-color: #2E3A4E;
        background-color: #182030;
    }

    QComboBox:focus {
        border-color: #2A8C7A;
    }

    QComboBox::drop-down {
        border: none;
        width: 22px;
    }

    QComboBox::down-arrow {
        image: none;
        border-left: 4px solid transparent;
        border-right: 4px solid transparent;
        border-top: 5px solid #9AA5B8;
        margin-right: 9px;
    }

    QComboBox QAbstractItemView {
        background-color: #182030;
        border: 1px solid #2E3A4E;
        border-radius: 8px;
        padding: 4px;
        color: #E9EEF7;
        selection-background-color: #173B36;
        selection-color: #4FE3C1;
        outline: none;
    }

    QPushButton {
        background-color: #131823;
        border: 1px solid #222B3B;
        border-radius: 9px;
        padding: 6px 12px;
        min-height: 26px;
        color: #E9EEF7;
    }

    QPushButton:hover {
        background-color: #182030;
        border-color: #2E3A4E;
    }

    QPushButton:pressed {
        background-color: #1D2635;
    }

    QPushButton:disabled {
        color: #64708A;
        border-color: #222B3B;
    }

    QPushButton:focus {
        border: 1px solid #2A8C7A;
    }

    QPushButton#Primary {
        background-color: #173B36;
        border: 1px solid #2A8C7A;
        color: #4FE3C1;
        font-weight: 600;
    }

    QPushButton#Primary:hover {
        background-color: #2A8C7A;
        color: #05100D;
    }

    QPushButton#Ghost {
        background: transparent;
        border: 1px solid transparent;
        color: #9AA5B8;
    }

    QPushButton#Ghost:hover {
        background-color: #182030;
        color: #E9EEF7;
    }

    QCheckBox {
        spacing: 8px;
        color: #9AA5B8;
    }

    QCheckBox::indicator {
        width: 16px;
        height: 16px;
        border-radius: 5px;
        border: 1px solid #2E3A4E;
        background-color: #131823;
    }

    QCheckBox::indicator:hover {
        border-color: #2A8C7A;
    }

    QCheckBox::indicator:checked {
        background-color: #4FE3C1;
        border-color: #4FE3C1;
    }

    QLineEdit {
        background-color: #131823;
        border: 1px solid #222B3B;
        border-radius: 9px;
        padding: 7px 12px;
        color: #E9EEF7;
        selection-background-color: #173B36;
    }

    QLineEdit:focus {
        border-color: #2A8C7A;
    }

    QTabWidget::pane {
        border: none;
        background: transparent;
    }

    QTabBar {
        background: transparent;
    }

    QTabBar::tab {
        background: transparent;
        color: #64708A;
        padding: 7px 15px;
        margin-right: 4px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    QTabBar::tab:hover {
        color: #9AA5B8;
        background-color: #131823;
    }

    QTabBar::tab:selected {
        color: #4FE3C1;
        background-color: #173B36;
    }

    QTableView {
        background-color: transparent;
        border: none;
        gridline-color: transparent;
        color: #9AA5B8;
        selection-background-color: #173B36;
        selection-color: #E9EEF7;
        alternate-background-color: #0E1118;
    }

    QTableView::item {
        border: none;
        padding: 2px 4px;
    }

    QTableView::item:selected {
        background-color: #173B36;
        color: #E9EEF7;
    }

    QHeaderView {
        background-color: transparent;
        border: none;
    }

    QHeaderView::section {
        background-color: transparent;
        color: #64708A;
        border: none;
        border-bottom: 1px solid #222B3B;
        padding: 8px 6px;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    QScrollBar:vertical {
        background: transparent;
        width: 10px;
        margin: 4px 2px 4px 2px;
    }

    QScrollBar::handle:vertical {
        background: #2E3A4E;
        border-radius: 4px;
        min-height: 28px;
    }

    QScrollBar::handle:vertical:hover {
        background: #64708A;
    }

    QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
        height: 0px;
        background: transparent;
    }

    QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
        background: transparent;
    }

    QScrollBar:horizontal {
        background: transparent;
        height: 10px;
        margin: 2px 4px;
    }

    QScrollBar::handle:horizontal {
        background: #2E3A4E;
        border-radius: 4px;
        min-width: 28px;
    }

    QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
        width: 0px;
        background: transparent;
    }

    QProgressBar {
        background-color: #131823;
        border: 1px solid #222B3B;
        border-radius: 5px;
        text-align: center;
        color: #9AA5B8;
        height: 8px;
    }

    QProgressBar::chunk {
        background-color: #4FE3C1;
        border-radius: 4px;
    }

    QMenu {
        background-color: #182030;
        border: 1px solid #2E3A4E;
        border-radius: 10px;
        padding: 6px;
        color: #E9EEF7;
    }

    QMenu::item {
        padding: 7px 22px 7px 14px;
        border-radius: 6px;
    }

    QMenu::item:selected {
        background-color: #173B36;
        color: #4FE3C1;
    }

    QMenu::separator {
        height: 1px;
        background-color: #222B3B;
        margin: 5px 8px;
    }

    QSplitter::handle {
        background-color: transparent;
        width: 14px;
    }

    QSplitter::handle:hover {
        background-color: #222B3B;
    }

    QScrollArea {
        border: none;
        background: transparent;
    }

    QStatusBar {
        background-color: #0E1118;
        color: #64708A;
        border-top: 1px solid #222B3B;
    }

    #Chip {
        background-color: #131823;
        border: 1px solid #222B3B;
        border-radius: 8px;
        padding: 3px 9px;
        color: #9AA5B8;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    #ChipAccent {
        background-color: #173B36;
        border: 1px solid #2A8C7A;
        border-radius: 8px;
        padding: 3px 9px;
        color: #4FE3C1;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    #ChipWarning {
        background-color: #3A2C14;
        border: 1px solid #F5B44B;
        border-radius: 8px;
        padding: 3px 9px;
        color: #F5B44B;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    #TileTitle {
        color: #64708A;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    #TileValue {
        color: #E9EEF7;
        font-size: 16px;
        font-weight: 600;
    }

    #TileSub {
        color: #64708A;
        font-size: 10px;
    }
